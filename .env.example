# EuroLens runs with no API keys. Both data sources are public:
#   - European Parliament Open Data API
#   - HowTheyVote.eu (roll-call votes)
#
# Supabase is optional and only powers sign-in and saved positions.
# Without it the app runs read-only for guests.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin, used for sitemap, canonical URLs and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ingest job (optional) -------------------------------------------------
# The scheduled job that mirrors European Parliament data into Supabase.
# Without these the app falls back to reading the EP API live, which still
# works — it is just slower and capped at a smaller catalogue.
#
# SERVICE ROLE KEY BYPASSES ROW LEVEL SECURITY. Never expose it to the
# browser, never prefix it with NEXT_PUBLIC_, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=
